{% liquid
  assign cta_collection = section.settings.collection
  assign fallback_handle = section.settings.fallback_collection_handle | strip | handleize

  if cta_collection == blank and fallback_handle != blank
    assign cta_collection = collections[fallback_handle]
  endif

  assign cta_url = section.settings.cta_link
  if cta_url == blank and cta_collection != blank
    assign cta_url = cta_collection.url
  endif
  if cta_url == blank
    assign cta_url = '/collections/all'
  endif
%}

<section class="premium-story-statement premium-story-statement-{{ section.id }}">
  <div class="premium-story-statement__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="premium-story-statement__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}

    {% if section.settings.statement != blank %}
      <div class="premium-story-statement__statement rte">{{ section.settings.statement }}</div>
    {% endif %}

    {% if section.settings.cta_label != blank %}
      <a class="premium-story-statement__button" href="{{ cta_url }}">
        {{ section.settings.cta_label | escape }}
      </a>
    {% endif %}
  </div>
</section>

{% style %}
  .premium-story-statement-{{ section.id }} {
    --premium-story-bg: {{ section.settings.background_color }};
    --premium-story-text: {{ section.settings.text_color }};
    --premium-story-muted: {{ section.settings.muted_color }};
    --premium-story-accent: {{ section.settings.accent_color }};
    --premium-story-ink: #1d1c1a;
    --premium-story-paper: #faf8f5;
    --premium-editorial-heading-font: 'Spectral', Georgia, 'Times New Roman', serif;
    --premium-editorial-body-font: var(--font-body--family);
    background: var(--premium-story-bg);
    color: var(--premium-story-text);
    font-family: var(--premium-editorial-body-font);
    text-align: center;
  }

  .premium-story-statement-{{ section.id }} .premium-story-statement__inner {
    width: min(calc(100% - 32px), 920px);
    margin-inline: auto;
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }

  .premium-story-statement-{{ section.id }} .premium-story-statement__eyebrow {
    color: var(--premium-story-accent);
    font-family: var(--premium-editorial-body-font);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1.4;
    margin: 0 0 18px;
    text-transform: uppercase;
  }

  .premium-story-statement-{{ section.id }} .premium-story-statement__statement {
    color: inherit;
    font-family: var(--premium-editorial-heading-font);
    font-size: clamp(4rem, 5vw, 6.4rem);
    font-weight: 300;
    letter-spacing: 0;
    line-height: 1.02;
  }

  .premium-story-statement-{{ section.id }} .premium-story-statement__statement p {
    margin: 0;
  }

  .premium-story-statement-{{ section.id }} .premium-story-statement__button {
    align-items: center;
    background: var(--premium-story-ink);
    border: 1px solid var(--premium-story-ink);
    border-radius: 2px;
    color: var(--premium-story-paper);
    display: inline-flex;
    font-family: var(--premium-editorial-body-font);
    font-size: 1.28rem;
    font-weight: 600;
    justify-content: center;
    letter-spacing: 0.04em;
    line-height: 1.2;
    margin-top: 34px;
    min-height: 50px;
    padding: 14px 26px;
    text-decoration: none;
    transition: background-color 220ms ease, border-color 220ms ease, color 220ms ease, transform 220ms ease;
  }

  .premium-story-statement-{{ section.id }} .premium-story-statement__button:hover {
    background: var(--premium-story-accent);
    border-color: var(--premium-story-accent);
    color: var(--premium-story-ink);
    transform: translateY(-1px);
  }

  .premium-story-statement-{{ section.id }} .premium-story-statement__button:focus-visible {
    outline: 2px solid var(--premium-story-accent);
    outline-offset: 4px;
  }

  @media screen and (max-width: 749px) {
    .premium-story-statement-{{ section.id }} .premium-story-statement__inner {
      padding-block: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_bottom }}px;
    }

    .premium-story-statement-{{ section.id }} .premium-story-statement__statement {
      font-size: 3.3rem;
      line-height: 1.06;
    }

    .premium-story-statement-{{ section.id }} .premium-story-statement__button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .premium-story-statement-{{ section.id }} .premium-story-statement__button {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Premium story statement",
  "class": "shopify-section--premium-story-statement",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "CANDY BEAD"
    },
    {
      "type": "richtext",
      "id": "statement",
      "label": "Statement",
      "default": "<p>Original design.<br>Made by hand.<br>Made to feel like yours.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "SHOP ALL BRACELETS"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "CTA fallback collection"
    },
    {
      "type": "text",
      "id": "fallback_collection_handle",
      "label": "Fallback collection handle",
      "default": "all-bracelets"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f7f4ef"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1d1c1a"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#77716b"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#d7aea3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 48,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 48,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 36,
      "max": 104,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 36,
      "max": 104,
      "step": 4,
      "unit": "px",
      "default": 76
    }
  ],
  "presets": [
    {
      "name": "Premium story statement"
    }
  ]
}
{% endschema %}
