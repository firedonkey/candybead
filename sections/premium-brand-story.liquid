{% liquid
  assign story_collection = section.settings.collection
  if story_collection == blank
    assign story_collection = collections.all
  endif

  assign fallback_image_1 = blank
  assign fallback_image_2 = blank
  assign fallback_image_3 = blank
  assign fallback_image_4 = blank
  if story_collection != blank and story_collection.products_count > 0
    for product in story_collection.products limit: 4
      assign product_image = product.featured_media.preview_image | default: product.featured_image
      case forloop.index
        when 1
          assign fallback_image_1 = product_image
        when 2
          assign fallback_image_2 = product_image
        when 3
          assign fallback_image_3 = product_image
        when 4
          assign fallback_image_4 = product_image
      endcase
    endfor
  endif

  assign collage_image_1 = section.settings.image_1
  assign collage_image_2 = section.settings.image_2
  assign collage_image_3 = section.settings.image_3
  assign collage_image_4 = section.settings.image_4

  if collage_image_1 == blank
    assign collage_image_1 = section.settings.image | default: fallback_image_1
  endif

  if collage_image_2 == blank
    assign collage_image_2 = section.settings.accent_image | default: fallback_image_2
  endif

  if collage_image_3 == blank
    assign collage_image_3 = fallback_image_3
  endif

  if collage_image_4 == blank
    assign collage_image_4 = fallback_image_4
  endif

  assign collage_image_1_alt = section.settings.image_1_alt | default: section.settings.image_alt | default: collage_image_1.alt | default: section.settings.heading | strip_html
  assign collage_image_2_alt = section.settings.image_2_alt | default: section.settings.accent_image_alt | default: collage_image_2.alt | default: section.settings.heading | strip_html
  assign collage_image_3_alt = section.settings.image_3_alt | default: collage_image_3.alt | default: section.settings.heading | strip_html
  assign collage_image_4_alt = section.settings.image_4_alt | default: collage_image_4.alt | default: section.settings.heading | strip_html

  assign collage_image_count = 0
  if collage_image_1 != blank
    assign collage_image_count = collage_image_count | plus: 1
  endif
  if collage_image_2 != blank
    assign collage_image_count = collage_image_count | plus: 1
  endif
  if collage_image_3 != blank
    assign collage_image_count = collage_image_count | plus: 1
  endif
  if collage_image_4 != blank
    assign collage_image_count = collage_image_count | plus: 1
  endif
%}

<section id="our-story" class="premium-brand-story premium-brand-story-{{ section.id }}">
  <div class="premium-brand-story__inner">
    <div class="premium-brand-story__media" data-image-count="{{ collage_image_count }}">
      {% if collage_image_count > 0 %}
        <div class="premium-brand-story__collage">
          {% liquid
            assign collage_position = 0
          %}

          {% if collage_image_1 != blank %}
            {% liquid
              assign collage_position = collage_position | plus: 1
            %}
            <div class="premium-brand-story__collage-card premium-brand-story__collage-card--{{ collage_position }}">
              {{
                collage_image_1
                | image_url: width: 1200
                | image_tag:
                  widths: '360, 480, 640, 820, 1000, 1200',
                  sizes: '(min-width: 990px) 28vw, (min-width: 750px) 42vw, 48vw',
                  alt: collage_image_1_alt,
                  class: 'premium-brand-story__image',
                  loading: 'lazy'
              }}
            </div>
          {% endif %}

          {% if collage_image_2 != blank %}
            {% liquid
              assign collage_position = collage_position | plus: 1
            %}
            <div class="premium-brand-story__collage-card premium-brand-story__collage-card--{{ collage_position }}">
              {{
                collage_image_2
                | image_url: width: 1200
                | image_tag:
                  widths: '360, 480, 640, 820, 1000, 1200',
                  sizes: '(min-width: 990px) 28vw, (min-width: 750px) 42vw, 48vw',
                  alt: collage_image_2_alt,
                  class: 'premium-brand-story__image',
                  loading: 'lazy'
              }}
            </div>
          {% endif %}

          {% if collage_image_3 != blank %}
            {% liquid
              assign collage_position = collage_position | plus: 1
            %}
            <div class="premium-brand-story__collage-card premium-brand-story__collage-card--{{ collage_position }}">
              {{
                collage_image_3
                | image_url: width: 1200
                | image_tag:
                  widths: '360, 480, 640, 820, 1000, 1200',
                  sizes: '(min-width: 990px) 28vw, (min-width: 750px) 42vw, 48vw',
                  alt: collage_image_3_alt,
                  class: 'premium-brand-story__image',
                  loading: 'lazy'
              }}
            </div>
          {% endif %}

          {% if collage_image_4 != blank %}
            {% liquid
              assign collage_position = collage_position | plus: 1
            %}
            <div class="premium-brand-story__collage-card premium-brand-story__collage-card--{{ collage_position }}">
              {{
                collage_image_4
                | image_url: width: 1200
                | image_tag:
                  widths: '360, 480, 640, 820, 1000, 1200',
                  sizes: '(min-width: 990px) 28vw, (min-width: 750px) 42vw, 48vw',
                  alt: collage_image_4_alt,
                  class: 'premium-brand-story__image',
                  loading: 'lazy'
              }}
            </div>
          {% endif %}
        </div>
      {% else %}
        <div class="premium-brand-story__collage premium-brand-story__collage--placeholder">
          {{
            'hero-apparel-2'
            | placeholder_svg_tag: 'premium-brand-story__placeholder'
          }}
        </div>
      {% endif %}
    </div>

    <div class="premium-brand-story__content">
      {% if section.settings.eyebrow != blank %}
        <p class="premium-brand-story__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="premium-brand-story__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="premium-brand-story__text rte">{{ section.settings.text }}</div>
      {% endif %}

      {% if section.settings.quote != blank %}
        <blockquote class="premium-brand-story__quote">{{ section.settings.quote | escape }}</blockquote>
      {% endif %}

      {% if section.settings.cta_label != blank %}
        <a class="premium-brand-story__link" href="{{ section.settings.cta_link | default: '/pages/our-story' }}">
          {{ section.settings.cta_label | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  .premium-brand-story-{{ section.id }} {
    --premium-story-bg: {{ section.settings.background_color }};
    --premium-story-text: {{ section.settings.text_color }};
    --premium-story-muted: {{ section.settings.muted_color }};
    --premium-story-accent: {{ section.settings.accent_color }};
    --premium-editorial-heading-font: 'Spectral', Georgia, 'Times New Roman', serif;
    --premium-editorial-body-font: var(--font-body--family);
    --premium-story-paper: #faf8f5;
    --premium-story-ink: #1d1c1a;
    background: var(--premium-story-bg);
    color: var(--premium-story-text);
    font-family: var(--premium-editorial-body-font);
    scroll-margin-top: calc(var(--header-height, 72px) + 24px);
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__inner {
    width: min(calc(100% - 32px), var(--normal-page-width, 120rem));
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 0.98fr) minmax(340px, 0.82fr);
    gap: clamp(56px, 7vw, 96px);
    align-items: center;
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__media {
    position: relative;
    min-width: 0;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__collage {
    aspect-ratio: 1 / 1;
    isolation: isolate;
    margin-inline: auto;
    max-width: 680px;
    position: relative;
    width: 100%;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__collage--placeholder {
    background: var(--premium-story-paper);
    border: 1px solid rgb(29 28 26 / 0.06);
    border-radius: 2px;
    overflow: hidden;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__collage-card {
    --premium-story-card-rotation: 0deg;
    --premium-story-card-scale: 1;
    aspect-ratio: 4 / 5;
    background: var(--premium-story-paper);
    border: 1px solid rgb(29 28 26 / 0.06);
    border-radius: 2px;
    box-shadow:
      0 10px 30px rgb(29 28 26 / 0.06),
      0 2px 8px rgb(29 28 26 / 0.04);
    box-sizing: border-box;
    overflow: hidden;
    padding: clamp(7px, 1vw, 12px);
    position: absolute;
    transform: rotate(var(--premium-story-card-rotation)) scale(var(--premium-story-card-scale));
    transform-origin: center;
    transition:
      box-shadow 220ms ease,
      transform 220ms ease;
    width: 54%;
    z-index: 1;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__collage-card--1 {
    --premium-story-card-rotation: -3deg;
    left: 1%;
    top: 5%;
    z-index: 1;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__collage-card--2 {
    --premium-story-card-rotation: 2deg;
    right: 2%;
    top: 0;
    z-index: 2;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__collage-card--3 {
    --premium-story-card-rotation: -2deg;
    bottom: 2%;
    left: 7%;
    z-index: 3;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__collage-card--4 {
    --premium-story-card-rotation: 2deg;
    bottom: 7%;
    right: 0;
    z-index: 4;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__media[data-image-count='1'] .premium-brand-story__collage-card--1 {
    left: 18%;
    top: 6%;
    width: 64%;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__media[data-image-count='2'] .premium-brand-story__collage-card--1 {
    left: 4%;
    top: 13%;
    width: 56%;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__media[data-image-count='2'] .premium-brand-story__collage-card--2 {
    right: 4%;
    top: 27%;
    width: 56%;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__media[data-image-count='3'] .premium-brand-story__collage-card--1 {
    left: 2%;
    top: 7%;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__media[data-image-count='3'] .premium-brand-story__collage-card--2 {
    right: 2%;
    top: 9%;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__media[data-image-count='3'] .premium-brand-story__collage-card--3 {
    bottom: 2%;
    left: 23%;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__image,
  .premium-brand-story-{{ section.id }} .premium-brand-story__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__collage-card .premium-brand-story__image {
    border-radius: 1px;
  }

  @media (hover: hover) and (pointer: fine) {
    .premium-brand-story-{{ section.id }} .premium-brand-story__collage-card:hover {
      --premium-story-card-scale: 1.015;
      box-shadow:
        0 14px 34px rgb(29 28 26 / 0.08),
        0 3px 10px rgb(29 28 26 / 0.05);
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__collage-card--1:hover,
    .premium-brand-story-{{ section.id }} .premium-brand-story__collage-card--3:hover {
      --premium-story-card-rotation: -1deg;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__collage-card--2:hover,
    .premium-brand-story-{{ section.id }} .premium-brand-story__collage-card--4:hover {
      --premium-story-card-rotation: 1deg;
    }
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__eyebrow {
    color: var(--premium-story-accent);
    font-family: var(--premium-editorial-body-font);
    font-size: 1rem;
    line-height: 1.4;
    letter-spacing: 0.16em;
    margin: 0 0 12px;
    text-transform: uppercase;
    font-weight: 600;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__heading {
    color: inherit;
    font-family: var(--premium-editorial-heading-font);
    font-style: normal;
    font-weight: 300;
    font-size: 5.4rem;
    line-height: 1;
    letter-spacing: 0;
    margin: 0;
    max-width: 12ch;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__text {
    color: var(--premium-story-muted);
    font-family: var(--premium-editorial-body-font);
    font-size: 1.58rem;
    line-height: 1.78;
    letter-spacing: 0;
    margin-top: 28px;
    max-width: 620px;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__text p {
    margin-block: 0 14px;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__quote {
    border-left: 1px solid var(--premium-story-accent);
    color: var(--premium-story-text);
    font-family: var(--premium-editorial-heading-font);
    font-style: normal;
    font-weight: 300;
    font-size: 1.9rem;
    line-height: 1.45;
    letter-spacing: 0;
    margin: 28px 0 0;
    padding-left: 20px;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__link {
    color: var(--premium-story-ink);
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    font-family: var(--premium-editorial-body-font);
    font-size: 1.28rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-top: 30px;
    transition: color 220ms ease;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__link::after {
    content: "\2192";
    font-size: 1.2em;
    line-height: 1;
    transition: transform 220ms ease;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__link:hover {
    color: var(--premium-story-accent);
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__link:hover::after {
    transform: translateX(3px);
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__link:focus-visible {
    outline: 2px solid var(--premium-story-accent);
    outline-offset: 4px;
  }

  @media screen and (max-width: 989px) {
    .premium-brand-story-{{ section.id }} .premium-brand-story__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__heading {
      font-size: 3.8rem;
      max-width: 14ch;
    }
  }

  @media screen and (min-width: 990px) and (max-width: 1099px) {
    .premium-brand-story-{{ section.id }} .premium-brand-story__collage-card {
      width: 52%;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__collage-card--1 {
      --premium-story-card-rotation: -2deg;
      left: 2%;
      top: 7%;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__collage-card--2 {
      --premium-story-card-rotation: 1.5deg;
      right: 2%;
      top: 3%;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__collage-card--3 {
      --premium-story-card-rotation: -1.5deg;
      bottom: 4%;
      left: 9%;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__collage-card--4 {
      --premium-story-card-rotation: 1.5deg;
      bottom: 8%;
      right: 1%;
    }
  }

  @media screen and (min-width: 750px) {
    .premium-brand-story-{{ section.id }} .premium-brand-story__inner {
      width: min(calc(100% - 80px), var(--normal-page-width, 120rem));
    }
  }

  @media screen and (max-width: 749px) {
    .premium-brand-story-{{ section.id }} .premium-brand-story__inner {
      padding-block: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_bottom }}px;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__media {
      overflow: visible;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__collage {
      aspect-ratio: 1 / 0.92;
      max-width: 520px;
      width: min(100%, 520px);
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__collage-card {
      aspect-ratio: 1 / 1.12;
      padding: 6px;
      width: 52%;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__collage-card--1 {
      --premium-story-card-rotation: -1.5deg;
      left: 0;
      top: 4%;
      z-index: 1;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__collage-card--2 {
      --premium-story-card-rotation: 1deg;
      right: 0;
      top: 9%;
      z-index: 2;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__collage-card--3 {
      --premium-story-card-rotation: -1deg;
      bottom: 2%;
      left: 2%;
      z-index: 3;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__collage-card--4 {
      --premium-story-card-rotation: 1.2deg;
      bottom: 0;
      right: 2%;
      z-index: 4;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__media[data-image-count='1'] .premium-brand-story__collage {
      aspect-ratio: 4 / 3;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__media[data-image-count='1'] .premium-brand-story__collage-card--1 {
      left: 12%;
      top: 0;
      width: 76%;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__media[data-image-count='2'] .premium-brand-story__collage {
      aspect-ratio: 1 / 0.74;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__media[data-image-count='2'] .premium-brand-story__collage-card--1 {
      left: 2%;
      top: 4%;
      width: 54%;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__media[data-image-count='2'] .premium-brand-story__collage-card--2 {
      right: 2%;
      top: 18%;
      width: 54%;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__media[data-image-count='3'] .premium-brand-story__collage {
      aspect-ratio: 1 / 0.9;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__media[data-image-count='3'] .premium-brand-story__collage-card--1 {
      left: 0;
      top: 3%;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__media[data-image-count='3'] .premium-brand-story__collage-card--2 {
      right: 0;
      top: 8%;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__media[data-image-count='3'] .premium-brand-story__collage-card--3 {
      bottom: 0;
      left: 23%;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__heading {
      font-size: 3.2rem;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__quote {
      font-size: 1.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .premium-brand-story-{{ section.id }} .premium-brand-story__link,
    .premium-brand-story-{{ section.id }} .premium-brand-story__link::after,
    .premium-brand-story-{{ section.id }} .premium-brand-story__collage-card {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
