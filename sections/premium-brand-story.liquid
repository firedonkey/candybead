  "settings": [
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "text",
      "id": "image_1_alt",
      "label": "Image 1 alt text"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "text",
      "id": "image_2_alt",
      "label": "Image 2 alt text"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "text",
      "id": "image_3_alt",
      "label": "Image 3 alt text"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image 4"
    },
    {
      "type": "text",
      "id": "image_4_alt",
      "label": "Image 4 alt text"
    },
    {
      "type": "header",
      "content": "Legacy image fallbacks"
    },
    {
      "type": "paragraph",
      "content": "Existing saved images still work as fallbacks for image 1 and image 2."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Legacy main image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Legacy main image alt text"
    },
    {
      "type": "image_picker",
      "id": "accent_image",
      "label": "Legacy accent image"
    },
    {
      "type": "text",
      "id": "accent_image_alt",
