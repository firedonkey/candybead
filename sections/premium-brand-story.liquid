{% liquid
  assign story_image = section.settings.image
  assign accent_image = section.settings.accent_image
  assign story_alt = section.settings.image_alt | default: story_image.alt | default: section.settings.heading | strip_html
  assign accent_alt = section.settings.accent_image_alt | default: accent_image.alt | default: section.settings.accent_caption | strip_html
%}

<section class="premium-brand-story premium-brand-story-{{ section.id }}">
  <div class="premium-brand-story__inner">
    <div class="premium-brand-story__media">
      <div class="premium-brand-story__image-wrap premium-brand-story__image-wrap--main">
        {% if story_image != blank %}
          {{
            story_image
            | image_url: width: 1600
            | image_tag:
              widths: '480, 720, 960, 1200, 1600',
              sizes: '(min-width: 990px) 48vw, 100vw',
              alt: story_alt,
              class: 'premium-brand-story__image',
              loading: 'lazy'
          }}
        {% else %}
          {{ 'hero-apparel-2' | placeholder_svg_tag: 'premium-brand-story__placeholder' }}
        {% endif %}
      </div>

      <div class="premium-brand-story__image-wrap premium-brand-story__image-wrap--accent">
        {% if accent_image != blank %}
          {{
            accent_image
            | image_url: width: 900
            | image_tag:
              widths: '320, 480, 640, 900',
              sizes: '(min-width: 990px) 24vw, 48vw',
              alt: accent_alt,
              class: 'premium-brand-story__image',
              loading: 'lazy'
          }}
        {% else %}
          {{ 'detailed-apparel-1' | placeholder_svg_tag: 'premium-brand-story__placeholder' }}
        {% endif %}
      </div>
    </div>

    <div class="premium-brand-story__content">
      {% if section.settings.eyebrow != blank %}
        <p class="premium-brand-story__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="premium-brand-story__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="premium-brand-story__text rte">{{ section.settings.text }}</div>
      {% endif %}

      {% if section.settings.quote != blank %}
        <blockquote class="premium-brand-story__quote">{{ section.settings.quote | escape }}</blockquote>
      {% endif %}

      {% if section.settings.cta_label != blank %}
        <a class="premium-brand-story__link" href="{{ section.settings.cta_link | default: '/collections/all' }}">
          {{ section.settings.cta_label | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  .premium-brand-story-{{ section.id }} {
    --premium-story-bg: {{ section.settings.background_color }};
    --premium-story-text: {{ section.settings.text_color }};
    --premium-story-muted: {{ section.settings.muted_color }};
    --premium-story-accent: {{ section.settings.accent_color }};
    background: var(--premium-story-bg);
    color: var(--premium-story-text);
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__inner {
    width: min(calc(100% - 32px), var(--normal-page-width, 120rem));
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.82fr);
    gap: 56px;
    align-items: center;
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__media {
    display: grid;
    grid-template-columns: 1fr 0.62fr;
    gap: 16px;
    align-items: end;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__image-wrap {
    background: #e8ece6;
    border-radius: 6px;
    overflow: hidden;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__image-wrap--main {
    aspect-ratio: 4 / 5;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__image-wrap--accent {
    aspect-ratio: 3 / 4;
    margin-bottom: 42px;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__image,
  .premium-brand-story-{{ section.id }} .premium-brand-story__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__eyebrow {
    color: var(--premium-story-accent);
    font-size: 1.1rem;
    line-height: 1.4;
    letter-spacing: 0;
    margin: 0 0 12px;
    text-transform: uppercase;
    font-weight: 600;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__heading {
    color: inherit;
    font-family: var(--font-heading--family);
    font-size: 4.8rem;
    line-height: 1.04;
    letter-spacing: 0;
    margin: 0;
    max-width: 12ch;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__text {
    color: var(--premium-story-muted);
    font-size: 1.55rem;
    line-height: 1.7;
    letter-spacing: 0;
    margin-top: 24px;
    max-width: 620px;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__text p {
    margin-block: 0 14px;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__quote {
    border-left: 1px solid var(--premium-story-accent);
    color: var(--premium-story-text);
    font-size: 1.9rem;
    line-height: 1.45;
    letter-spacing: 0;
    margin: 28px 0 0;
    padding-left: 20px;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__link {
    color: inherit;
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    border-bottom: 1px solid currentColor;
    text-decoration: none;
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: 0;
    margin-top: 30px;
  }

  @media screen and (max-width: 989px) {
    .premium-brand-story-{{ section.id }} .premium-brand-story__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__heading {
      font-size: 3.5rem;
      max-width: 14ch;
    }
  }

  @media screen and (min-width: 750px) {
    .premium-brand-story-{{ section.id }} .premium-brand-story__inner {
      width: min(calc(100% - 80px), var(--normal-page-width, 120rem));
    }
  }

  @media screen and (max-width: 749px) {
    .premium-brand-story-{{ section.id }} .premium-brand-story__inner {
      padding-block: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_bottom }}px;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__media {
      grid-template-columns: 1fr;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__image-wrap--accent {
      display: none;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__heading {
      font-size: 3rem;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__quote {
      font-size: 1.6rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Premium brand story",
  "class": "shopify-section--premium-brand-story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Main image alt text"
    },
    {
      "type": "image_picker",
      "id": "accent_image",
      "label": "Accent image"
    },
    {
      "type": "text",
      "id": "accent_image_alt",
      "label": "Accent image alt text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our story"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Small adornments, chosen with feeling"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Candy Bead is built around the intimate ritual of choosing what to wear close: color for confidence, shine for ceremony, and details that make the everyday feel considered.</p><p>Each homepage edit can be tuned by collection, mood, and moment from the theme editor.</p>"
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Pull quote",
      "default": "Jewelry is a small signal, but it can change the whole mood."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Link label",
      "default": "Shop the full collection"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#e8ece6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1c1917"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#5f6159"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#8c5e58"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 40,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 40,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 28,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 28,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Premium brand story"
    }
  ]
}
{% endschema %}
