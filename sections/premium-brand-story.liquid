{% liquid
  assign story_collection = section.settings.collection
  if story_collection == blank
    assign story_collection = collections.all
  endif

  assign fallback_story_image = blank
  assign fallback_accent_image = blank
  if story_collection != blank and story_collection.products_count > 0
    for product in story_collection.products limit: 2
      assign product_image = product.featured_media.preview_image | default: product.featured_image
      if forloop.first
        assign fallback_story_image = product_image
      else
        assign fallback_accent_image = product_image
      endif
    endfor
  endif
  assign fallback_accent_image = fallback_accent_image | default: fallback_story_image

  assign story_image = section.settings.image
  assign accent_image = section.settings.accent_image
  assign story_image_class = 'premium-brand-story__image'
  assign accent_image_class = 'premium-brand-story__image'

  if story_image == blank and fallback_story_image != blank
    assign story_image = fallback_story_image
    assign story_image_class = story_image_class | append: ' premium-brand-story__image--product'
  endif

  if accent_image == blank and fallback_accent_image != blank
    assign accent_image = fallback_accent_image
    assign accent_image_class = accent_image_class | append: ' premium-brand-story__image--product'
  endif

  assign story_alt = section.settings.image_alt | default: story_image.alt | default: section.settings.heading | strip_html
  assign accent_alt = section.settings.accent_image_alt | default: accent_image.alt | default: section.settings.heading | strip_html
%}

<section class="premium-brand-story premium-brand-story-{{ section.id }}">
  <div class="premium-brand-story__inner">
    <div class="premium-brand-story__media">
      <div class="premium-brand-story__image-wrap premium-brand-story__image-wrap--main">
        {% if story_image != blank %}
          {{
            story_image
            | image_url: width: 1600
            | image_tag:
              widths: '480, 720, 960, 1200, 1600',
              sizes: '(min-width: 990px) 48vw, 100vw',
              alt: story_alt,
              class: story_image_class,
              loading: 'lazy'
          }}
        {% else %}
          {{ 'hero-apparel-2' | placeholder_svg_tag: 'premium-brand-story__placeholder' }}
        {% endif %}
      </div>

      <div class="premium-brand-story__image-wrap premium-brand-story__image-wrap--accent">
        {% if accent_image != blank %}
          {{
            accent_image
            | image_url: width: 900
            | image_tag:
              widths: '320, 480, 640, 900',
              sizes: '(min-width: 990px) 24vw, 48vw',
              alt: accent_alt,
              class: accent_image_class,
              loading: 'lazy'
          }}
        {% else %}
          {{ 'detailed-apparel-1' | placeholder_svg_tag: 'premium-brand-story__placeholder' }}
        {% endif %}
      </div>
    </div>

    <div class="premium-brand-story__content">
      {% if section.settings.eyebrow != blank %}
        <p class="premium-brand-story__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="premium-brand-story__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="premium-brand-story__text rte">{{ section.settings.text }}</div>
      {% endif %}

      {% if section.settings.quote != blank %}
        <blockquote class="premium-brand-story__quote">{{ section.settings.quote | escape }}</blockquote>
      {% endif %}

      {% if section.settings.cta_label != blank %}
        <a class="premium-brand-story__link" href="{{ section.settings.cta_link | default: '/collections/all' }}">
          {{ section.settings.cta_label | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  .premium-brand-story-{{ section.id }} {
    --premium-story-bg: {{ section.settings.background_color }};
    --premium-story-text: {{ section.settings.text_color }};
    --premium-story-muted: {{ section.settings.muted_color }};
    --premium-story-accent: {{ section.settings.accent_color }};
    --premium-editorial-heading-font: 'Spectral', Georgia, 'Times New Roman', serif;
    --premium-editorial-body-font: var(--font-body--family);
    --premium-story-paper: #faf8f5;
    --premium-story-ink: #1d1c1a;
    background: var(--premium-story-bg);
    color: var(--premium-story-text);
    font-family: var(--premium-editorial-body-font);
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__inner {
    width: min(calc(100% - 32px), var(--normal-page-width, 120rem));
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 0.98fr) minmax(340px, 0.82fr);
    gap: clamp(56px, 7vw, 96px);
    align-items: center;
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__media {
    position: relative;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__image-wrap {
    background: var(--premium-story-paper);
    border: 1px solid rgb(29 28 26 / 0.08);
    border-radius: 2px;
    overflow: hidden;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__image-wrap--main {
    aspect-ratio: 5 / 6;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__image-wrap--accent {
    aspect-ratio: 3 / 4;
    border: 10px solid var(--premium-story-bg);
    bottom: -30px;
    max-width: 230px;
    position: absolute;
    right: -24px;
    width: 38%;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__image,
  .premium-brand-story-{{ section.id }} .premium-brand-story__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__image--product {
    background: #ffffff;
    box-sizing: border-box;
    object-fit: contain;
    padding: clamp(24px, 5vw, 56px);
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__image-wrap--accent .premium-brand-story__image--product {
    padding: clamp(14px, 3vw, 28px);
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__eyebrow {
    color: var(--premium-story-accent);
    font-family: var(--premium-editorial-body-font);
    font-size: 1rem;
    line-height: 1.4;
    letter-spacing: 0.16em;
    margin: 0 0 12px;
    text-transform: uppercase;
    font-weight: 600;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__heading {
    color: inherit;
    font-family: var(--premium-editorial-heading-font);
    font-style: normal;
    font-weight: 300;
    font-size: 5.4rem;
    line-height: 1;
    letter-spacing: 0;
    margin: 0;
    max-width: 12ch;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__text {
    color: var(--premium-story-muted);
    font-family: var(--premium-editorial-body-font);
    font-size: 1.58rem;
    line-height: 1.78;
    letter-spacing: 0;
    margin-top: 28px;
    max-width: 620px;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__text p {
    margin-block: 0 14px;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__quote {
    border-left: 1px solid var(--premium-story-accent);
    color: var(--premium-story-text);
    font-family: var(--premium-editorial-heading-font);
    font-style: normal;
    font-weight: 300;
    font-size: 1.9rem;
    line-height: 1.45;
    letter-spacing: 0;
    margin: 28px 0 0;
    padding-left: 20px;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__link {
    color: var(--premium-story-ink);
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    font-family: var(--premium-editorial-body-font);
    font-size: 1.28rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-top: 30px;
    transition: color 220ms ease;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__link::after {
    content: "\2192";
    font-size: 1.2em;
    line-height: 1;
    transition: transform 220ms ease;
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__link:hover {
    color: var(--premium-story-accent);
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__link:hover::after {
    transform: translateX(3px);
  }

  .premium-brand-story-{{ section.id }} .premium-brand-story__link:focus-visible {
    outline: 2px solid var(--premium-story-accent);
    outline-offset: 4px;
  }

  @media screen and (max-width: 989px) {
    .premium-brand-story-{{ section.id }} .premium-brand-story__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__heading {
      font-size: 3.8rem;
      max-width: 14ch;
    }
  }

  @media screen and (min-width: 750px) {
    .premium-brand-story-{{ section.id }} .premium-brand-story__inner {
      width: min(calc(100% - 80px), var(--normal-page-width, 120rem));
    }
  }

  @media screen and (max-width: 749px) {
    .premium-brand-story-{{ section.id }} .premium-brand-story__inner {
      padding-block: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_bottom }}px;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__media {
      grid-template-columns: 1fr;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__image-wrap--accent {
      display: none;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__heading {
      font-size: 3.2rem;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__quote {
      font-size: 1.6rem;
    }

    .premium-brand-story-{{ section.id }} .premium-brand-story__image--product {
      padding: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .premium-brand-story-{{ section.id }} .premium-brand-story__link,
    .premium-brand-story-{{ section.id }} .premium-brand-story__link::after {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Premium brand story",
  "class": "shopify-section--premium-brand-story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Main image alt text"
    },
    {
      "type": "image_picker",
      "id": "accent_image",
      "label": "Accent image"
    },
    {
      "type": "text",
      "id": "accent_image_alt",
      "label": "Accent image alt text"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product image fallback collection",
      "info": "Used for story imagery when custom images are blank."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OUR STORY"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Made slowly. Worn often."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Natural stones, pearls, and playful details come together in pieces designed to feel personal, expressive, and easy to wear every day.</p>"
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Pull quote",
      "default": "Jewelry is a small signal, but it can change the whole mood."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Link label",
      "default": "Discover our story"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f7f4ef"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1d1c1a"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#77716b"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#d7aea3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 40,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 40,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 28,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 68
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 28,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 68
    }
  ],
  "presets": [
    {
      "name": "Premium brand story"
    }
  ]
}
{% endschema %}
