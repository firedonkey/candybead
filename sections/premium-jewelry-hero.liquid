{% liquid
  assign hero_image = section.settings.image
  assign hero_alt = section.settings.image_alt | default: hero_image.alt | default: section.settings.heading | strip_html
  assign overlay_opacity = section.settings.overlay_opacity | times: 0.01
%}

<section class="premium-jewelry-hero premium-jewelry-hero-{{ section.id }}">
  <div class="premium-jewelry-hero__media" aria-hidden="true">
    {% if hero_image != blank %}
      {{
        hero_image
        | image_url: width: 3200
        | image_tag:
          widths: '750, 1100, 1500, 2000, 2600, 3200',
          sizes: '100vw',
          alt: hero_alt,
          class: 'premium-jewelry-hero__image',
          loading: 'eager',
          fetchpriority: 'high'
      }}
    {% else %}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'premium-jewelry-hero__placeholder' }}
    {% endif %}
  </div>

  <div class="premium-jewelry-hero__overlay"></div>

  <div class="premium-jewelry-hero__inner">
    <div class="premium-jewelry-hero__content">
      {% if section.settings.eyebrow != blank %}
        <p class="premium-jewelry-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="premium-jewelry-hero__heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="premium-jewelry-hero__text rte">{{ section.settings.text }}</div>
      {% endif %}

      <div class="premium-jewelry-hero__actions">
        {% if section.settings.primary_label != blank %}
          <a
            class="premium-jewelry-hero__button premium-jewelry-hero__button--primary"
            href="{{ section.settings.primary_link | default: '/collections/all' }}"
          >
            {{ section.settings.primary_label | escape }}
          </a>
        {% endif %}

        {% if section.settings.secondary_label != blank %}
          <a
            class="premium-jewelry-hero__button premium-jewelry-hero__button--secondary"
            href="{{ section.settings.secondary_link | default: '/collections/all' }}"
          >
            {{ section.settings.secondary_label | escape }}
          </a>
        {% endif %}
      </div>

      {% if section.settings.note != blank %}
        <p class="premium-jewelry-hero__note">{{ section.settings.note | escape }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  .premium-jewelry-hero-{{ section.id }} {
    --premium-hero-text: {{ section.settings.text_color }};
    --premium-hero-overlay: {{ section.settings.overlay_color }};
    --premium-hero-overlay-opacity: {{ overlay_opacity }};
    --premium-hero-accent: {{ section.settings.accent_color }};
    --premium-editorial-heading-font: 'Spectral', Georgia, 'Times New Roman', serif;
    --premium-editorial-body-font: var(--font-body--family);
    --premium-hero-ink: #1d1c1a;
    --premium-hero-paper: #faf8f5;
    color: var(--premium-hero-text);
    min-height: clamp(660px, {{ section.settings.hero_height }}svh, 780px);
    position: relative;
    overflow: hidden;
    background: var(--premium-hero-ink);
    display: flex;
    align-items: center;
    font-family: var(--premium-editorial-body-font);
  }

  .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__media,
  .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__overlay {
    position: absolute;
    inset: 0;
  }

  .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__media {
    background: #c8b5aa;
  }

  .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__image,
  .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
    display: block;
  }

  .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__placeholder {
    background: #302b27;
  }

  .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__overlay {
    background:
      linear-gradient(90deg, var(--premium-hero-overlay) 0%, rgb(29 28 26 / 0.48) 42%, transparent 78%),
      linear-gradient(0deg, rgb(29 28 26 / 0.46) 0%, transparent 46%);
    opacity: var(--premium-hero-overlay-opacity);
    pointer-events: none;
  }

  .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__inner {
    position: relative;
    z-index: 1;
    width: min(calc(100% - 32px), var(--normal-page-width, 120rem));
    margin-inline: auto;
    padding-block: 126px 82px;
  }

  .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__content {
    max-width: 680px;
  }

  .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__eyebrow,
  .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__note {
    margin: 0;
    font-family: var(--premium-editorial-body-font);
    font-size: 1.1rem;
    line-height: 1.45;
    letter-spacing: 0.16em;
  }

  .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__eyebrow {
    color: var(--premium-hero-accent);
    text-transform: uppercase;
    font-weight: 600;
  }

  .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__heading {
    margin: 16px 0 0;
    color: inherit;
    font-family: var(--premium-editorial-heading-font);
    font-style: normal;
    font-weight: 300;
    font-size: 7.6rem;
    line-height: 0.98;
    letter-spacing: 0;
    max-width: 12ch;
  }

  .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__text {
    margin-top: 24px;
    max-width: 520px;
    color: rgb(250 248 245 / 0.88);
    font-family: var(--premium-editorial-body-font);
    font-size: 1.7rem;
    line-height: 1.65;
    letter-spacing: 0;
  }

  .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__text p {
    margin: 0;
  }

  .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__button {
    min-height: 48px;
    padding: 14px 24px;
    border-radius: 2px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    text-decoration: none;
    font-family: var(--premium-editorial-body-font);
    font-size: 1.25rem;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0.04em;
    transition: background-color 220ms ease, color 220ms ease, border-color 220ms ease, transform 220ms ease;
  }

  .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__button--primary {
    background: var(--premium-hero-ink);
    color: var(--premium-hero-paper);
    border: 1px solid var(--premium-hero-ink);
    box-shadow: inset 0 0 0 1px rgb(250 248 245 / 0.12);
  }

  .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__button--secondary {
    background: transparent;
    border: 1px solid rgb(250 248 245 / 0.72);
    color: var(--premium-hero-paper);
    gap: 8px;
  }

  .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__button--secondary::after {
    content: "\2192";
    font-size: 1.2em;
    line-height: 1;
  }

  .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__button:hover {
    background: var(--premium-hero-accent);
    border-color: var(--premium-hero-accent);
    color: var(--premium-hero-ink);
    transform: translateY(-1px);
  }

  .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__button:focus-visible {
    outline: 2px solid var(--premium-hero-paper);
    outline-offset: 4px;
  }

  .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__note {
    margin-top: 22px;
    color: rgb(250 248 245 / 0.74);
    letter-spacing: 0.02em;
  }

  @media screen and (min-width: 990px) {
    .premium-jewelry-hero-{{ section.id }} {
      min-height: clamp(600px, 33.34375vw, 780px);
    }

    .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__image {
      object-fit: contain;
    }

    .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__inner {
      padding-block: 64px;
    }

    .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__heading {
      font-size: clamp(5.2rem, 4.4vw, 7.2rem);
    }

    .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__text {
      margin-top: 18px;
      font-size: 1.55rem;
    }

    .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__actions {
      margin-top: 26px;
    }

    .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__note {
      margin-top: 16px;
    }
  }

  @media screen and (max-width: 989px) {
    .premium-jewelry-hero-{{ section.id }} {
      min-height: clamp(660px, 82svh, 740px);
    }

    .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__inner {
      padding-block: 116px 64px;
    }

    .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__heading {
      font-size: 5.2rem;
      line-height: 1;
      max-width: 12ch;
    }
  }

  @media screen and (min-width: 750px) {
    .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__inner {
      width: min(calc(100% - 80px), var(--normal-page-width, 120rem));
    }
  }

  @media screen and (max-width: 749px) {
    .premium-jewelry-hero-{{ section.id }} {
      min-height: 650px;
    }

    .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__inner {
      padding-block: 96px 44px;
    }

    .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__heading {
      font-size: 3.4rem;
      line-height: 1.02;
      max-width: 12ch;
    }

    .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__text {
      margin-top: 20px;
      font-size: 1.35rem;
      line-height: 1.6;
    }

    .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__actions {
      width: 100%;
      gap: 10px;
      margin-top: 26px;
    }

    .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__button {
      flex: 1 1 170px;
      min-height: 44px;
      padding: 12px 16px;
    }

    .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__note {
      margin-top: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .premium-jewelry-hero-{{ section.id }} .premium-jewelry-hero__button {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Premium jewelry hero",
  "class": "shopify-section--premium-jewelry-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "center center",
          "label": "Center"
        },
        {
          "value": "center top",
          "label": "Top"
        },
        {
          "value": "center bottom",
          "label": "Bottom"
        },
        {
          "value": "left center",
          "label": "Left"
        },
        {
          "value": "right center",
          "label": "Right"
        }
      ],
      "default": "center center"
    },
    {
      "type": "range",
      "id": "hero_height",
      "label": "Desktop hero height",
      "min": 58,
      "max": 92,
      "step": 1,
      "unit": "vh",
      "default": 78
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New season edit"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Jewelry for the way the day feels"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Delicate color, polished metals, and quietly expressive pieces to layer, gift, and keep close.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop new arrivals"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Explore best sellers"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small note",
      "default": "Curated for stacking, gifting, and everyday ritual."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#faf8f5"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#d7aea3"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#1d1c1a"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Premium jewelry hero"
    }
  ]
}
{% endschema %}
