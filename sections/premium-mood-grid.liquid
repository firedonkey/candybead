<section id="shop-by-mood" class="premium-mood-grid premium-mood-grid-{{ section.id }}">
  <div class="premium-mood-grid__inner">
    <div class="premium-mood-grid__header">
      {% if section.settings.eyebrow != blank %}
        <p class="premium-mood-grid__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="premium-mood-grid__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="premium-mood-grid__text rte">{{ section.settings.text }}</div>
      {% endif %}
    </div>

    <div class="premium-mood-grid__items">
      {% for block in section.blocks %}
        {% liquid
          assign mood_collection = block.settings.collection
          assign fallback_collection_handle = block.settings.fallback_collection_handle | strip | handleize

          if mood_collection == blank and fallback_collection_handle != blank
            assign mood_collection = collections[fallback_collection_handle]
          endif

          assign mood_image = block.settings.image
          if mood_image == blank and mood_collection.image != blank
            assign mood_image = mood_collection.image
          endif
          if mood_image == blank and mood_collection.products.first.featured_image != blank
            assign mood_image = mood_collection.products.first.featured_image
          endif

          assign mood_url = ''
          if mood_collection != blank
            assign mood_url = mood_collection.url
          endif
          if mood_url == blank and fallback_collection_handle != blank
            assign mood_url = '/collections/' | append: fallback_collection_handle
          endif
          if mood_url == blank
            assign mood_url = '/collections/all'
          endif

          assign mood_alt = mood_image.alt | default: block.settings.title | escape
        %}

        <a class="premium-mood-grid__item" href="{{ mood_url }}" {{ block.shopify_attributes }}>
          <span class="premium-mood-grid__media">
            {% if mood_image != blank %}
              {{
                mood_image
                | image_url: width: 1200
                | image_tag:
                  widths: '360, 520, 720, 900, 1200',
                  sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw',
                  alt: mood_alt,
                  class: 'premium-mood-grid__image',
                  loading: 'lazy'
              }}
            {% else %}
              {{ 'collection-apparel-1' | placeholder_svg_tag: 'premium-mood-grid__placeholder' }}
            {% endif %}
          </span>

          <span class="premium-mood-grid__content">
            {% if block.settings.title != blank %}
              <span class="premium-mood-grid__title">{{ block.settings.title | escape }}</span>
            {% endif %}
            {% if block.settings.text != blank %}
              <span class="premium-mood-grid__description">{{ block.settings.text | escape }}</span>
            {% endif %}
            {% if block.settings.link_label != blank %}
              <span class="premium-mood-grid__link">{{ block.settings.link_label | escape }}</span>
            {% endif %}
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
  .premium-mood-grid-{{ section.id }} {
    --premium-mood-bg: {{ section.settings.background_color }};
    --premium-mood-text: {{ section.settings.text_color }};
    --premium-mood-muted: {{ section.settings.muted_color }};
    --premium-mood-accent: {{ section.settings.accent_color }};
    --premium-editorial-heading-font: 'Spectral', Georgia, 'Times New Roman', serif;
    --premium-editorial-body-font: var(--font-body--family);
    --premium-mood-paper: #faf8f5;
    --premium-mood-ink: #1d1c1a;
    background: var(--premium-mood-bg);
    color: var(--premium-mood-text);
    font-family: var(--premium-editorial-body-font);
    scroll-margin-top: calc(var(--header-height, 72px) + 24px);
  }

  .premium-mood-grid-{{ section.id }} .premium-mood-grid__inner {
    width: min(calc(100% - 32px), var(--normal-page-width, 120rem));
    margin-inline: auto;
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }

  .premium-mood-grid-{{ section.id }} .premium-mood-grid__header {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(280px, 0.5fr);
    gap: 32px;
    align-items: end;
    margin-bottom: 46px;
  }

  .premium-mood-grid-{{ section.id }} .premium-mood-grid__eyebrow {
    color: var(--premium-mood-accent);
    font-family: var(--premium-editorial-body-font);
    font-size: 1rem;
    line-height: 1.4;
    letter-spacing: 0.16em;
    margin: 0 0 10px;
    text-transform: uppercase;
    font-weight: 600;
  }

  .premium-mood-grid-{{ section.id }} .premium-mood-grid__heading {
    color: inherit;
    font-family: var(--premium-editorial-heading-font);
    font-style: normal;
    font-weight: 300;
    font-size: 4.3rem;
    line-height: 1.03;
    letter-spacing: 0;
    margin: 0;
    max-width: 18ch;
  }

  .premium-mood-grid-{{ section.id }} .premium-mood-grid__text {
    color: var(--premium-mood-muted);
    font-family: var(--premium-editorial-body-font);
    font-size: 1.48rem;
    line-height: 1.7;
    letter-spacing: 0;
    max-width: 520px;
  }

  .premium-mood-grid-{{ section.id }} .premium-mood-grid__text p {
    margin: 0;
  }

  .premium-mood-grid-{{ section.id }} .premium-mood-grid__items {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .premium-mood-grid-{{ section.id }} .premium-mood-grid__item {
    aspect-ratio: 4 / 5;
    background: var(--premium-mood-ink);
    border-radius: 2px;
    color: var(--premium-mood-paper);
    display: block;
    overflow: hidden;
    position: relative;
    text-decoration: none;
    min-width: 0;
  }

  .premium-mood-grid-{{ section.id }} .premium-mood-grid__item:nth-child(4):last-child {
    aspect-ratio: 4.6 / 1;
    grid-column: 1 / -1;
  }

  .premium-mood-grid-{{ section.id }} .premium-mood-grid__item::after {
    background: linear-gradient(0deg, rgb(29 28 26 / 0.58) 0%, rgb(29 28 26 / 0.22) 50%, transparent 100%);
    content: "";
    inset: 0;
    pointer-events: none;
    position: absolute;
    z-index: 1;
  }

  .premium-mood-grid-{{ section.id }} .premium-mood-grid__media {
    background: #c9cec3;
    display: block;
    inset: 0;
    overflow: hidden;
    position: absolute;
  }

  .premium-mood-grid-{{ section.id }} .premium-mood-grid__image,
  .premium-mood-grid-{{ section.id }} .premium-mood-grid__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 240ms ease;
  }

  .premium-mood-grid-{{ section.id }} .premium-mood-grid__item:hover .premium-mood-grid__image {
    transform: scale(1.03);
  }

  .premium-mood-grid-{{ section.id }} .premium-mood-grid__content {
    bottom: 0;
    display: grid;
    gap: 8px;
    left: 0;
    padding: 24px;
    position: absolute;
    right: 0;
    z-index: 2;
  }

  .premium-mood-grid-{{ section.id }} .premium-mood-grid__title {
    color: inherit;
    font-family: var(--premium-editorial-heading-font);
    font-size: 2.4rem;
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: 0;
  }

  .premium-mood-grid-{{ section.id }} .premium-mood-grid__description {
    color: rgb(250 248 245 / 0.78);
    font-family: var(--premium-editorial-body-font);
    font-size: 1.32rem;
    line-height: 1.55;
    letter-spacing: 0;
    max-width: 34ch;
  }

  .premium-mood-grid-{{ section.id }} .premium-mood-grid__link {
    color: rgb(250 248 245 / 0.9);
    display: inline-flex;
    gap: 8px;
    justify-self: start;
    font-size: 1.25rem;
    line-height: 1.4;
    letter-spacing: 0.04em;
    font-weight: 600;
    margin-top: 6px;
  }

  .premium-mood-grid-{{ section.id }} .premium-mood-grid__link::after {
    content: "\2192";
    font-size: 1.15em;
    line-height: 1;
    transition: transform 220ms ease;
  }

  .premium-mood-grid-{{ section.id }} .premium-mood-grid__item:hover .premium-mood-grid__link::after {
    transform: translateX(3px);
  }

  .premium-mood-grid-{{ section.id }} .premium-mood-grid__item:focus-visible {
    outline: 2px solid var(--premium-mood-accent);
    outline-offset: 4px;
  }

  @media screen and (max-width: 989px) {
    .premium-mood-grid-{{ section.id }} .premium-mood-grid__header {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .premium-mood-grid-{{ section.id }} .premium-mood-grid__heading {
      font-size: 3.5rem;
    }

    .premium-mood-grid-{{ section.id }} .premium-mood-grid__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .premium-mood-grid-{{ section.id }} .premium-mood-grid__item:nth-child(4):last-child {
      aspect-ratio: 4 / 5;
      grid-column: auto;
    }
  }

  @media screen and (min-width: 750px) {
    .premium-mood-grid-{{ section.id }} .premium-mood-grid__inner {
      width: min(calc(100% - 80px), var(--normal-page-width, 120rem));
    }
  }

  @media screen and (max-width: 749px) {
    .premium-mood-grid-{{ section.id }} .premium-mood-grid__inner {
      padding-block: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_bottom }}px;
    }

    .premium-mood-grid-{{ section.id }} .premium-mood-grid__heading {
      font-size: 2.8rem;
    }

    .premium-mood-grid-{{ section.id }} .premium-mood-grid__items {
      grid-auto-columns: minmax(260px, 82vw);
      grid-auto-flow: column;
      grid-template-columns: none;
      margin-inline: -16px;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      padding: 0 16px 6px;
      scroll-padding-inline: 16px;
      scroll-snap-type: x mandatory;
    }

    .premium-mood-grid-{{ section.id }} .premium-mood-grid__item {
      aspect-ratio: 4 / 5;
      scroll-snap-align: start;
    }

    .premium-mood-grid-{{ section.id }} .premium-mood-grid__item:nth-child(4):last-child {
      aspect-ratio: 4 / 5;
      grid-column: auto;
    }

    .premium-mood-grid-{{ section.id }} .premium-mood-grid__content {
      padding: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .premium-mood-grid-{{ section.id }} .premium-mood-grid__image,
    .premium-mood-grid-{{ section.id }} .premium-mood-grid__link::after {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Premium shop by mood",
  "class": "shopify-section--premium-mood-grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by mood"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Find the piece that matches the moment"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Curated paths into color, shine, sentiment, and celebration.</p>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f7f4ef"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1d1c1a"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#77716b"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#d7aea3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 32,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 104
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 32,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 104
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 24,
      "max": 88,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 24,
      "max": 88,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "mood",
      "name": "Mood",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "fallback_collection_handle",
          "label": "Fallback collection handle",
          "info": "Used when no collection is selected. Example: everyday-shine.",
          "default": "everyday-shine"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Everyday shine"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Easy pieces for repeat wear."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Shop the mood"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Premium shop by mood",
      "blocks": [
        {
          "type": "mood",
          "settings": {
            "title": "Everyday shine",
            "text": "Soft sparkle for the daily stack.",
            "fallback_collection_handle": "everyday-shine"
          }
        },
        {
          "type": "mood",
          "settings": {
            "title": "Color ritual",
            "text": "Candy-bright beads and playful accents.",
            "fallback_collection_handle": "color-ritual"
          }
        },
        {
          "type": "mood",
          "settings": {
            "title": "Gift ready",
            "text": "Pieces chosen for meaning and delight.",
            "fallback_collection_handle": "gift-ready"
          }
        },
        {
          "type": "mood",
          "settings": {
            "title": "Evening polish",
            "text": "Refined shine for after-dark plans.",
            "fallback_collection_handle": "evening-polish"
          }
        }
      ]
    }
  ]
}
{% endschema %}
