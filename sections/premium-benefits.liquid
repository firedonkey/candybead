      "settings": [
        {
          "type": "text",
          "id": "marker",
          "label": "Marker",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Handmade with care"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Thoughtfully assembled in small batches"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Premium benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "marker": "01",
            "title": "Handmade with care",
            "text": "Thoughtfully assembled in small batches"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "marker": "02",
            "title": "Natural materials",
            "text": "Pearls, stones, crystals, and organic textures"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "marker": "03",
            "title": "Gift-ready",
            "text": "Beautiful pieces made for giving"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "marker": "04",
            "title": "Easy shopping",
            "text": "Simple, secure checkout"
          }
        }
      ]
