    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Premium benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "marker": "01",
            "title": "Secure checkout",
            "text": "Protected Shopify checkout with familiar payment options."
          }
        },
        {
          "type": "benefit",
