<section class="premium-benefits premium-benefits-{{ section.id }}">
  <div class="premium-benefits__inner">
    <div class="premium-benefits__header">
      {% if section.settings.heading != blank %}
        <h2 class="premium-benefits__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="premium-benefits__text rte">{{ section.settings.text }}</div>
      {% endif %}
    </div>

    <div class="premium-benefits__items" role="list">
      {% for block in section.blocks %}
        <div class="premium-benefits__item" role="listitem" {{ block.shopify_attributes }}>
          {% if block.settings.marker != blank %}
            <span class="premium-benefits__marker">{{ block.settings.marker | escape }}</span>
          {% endif %}

          {% if block.settings.title != blank %}
            <h3 class="premium-benefits__title">{{ block.settings.title | escape }}</h3>
          {% endif %}

          {% if block.settings.text != blank %}
            <p class="premium-benefits__description">{{ block.settings.text | escape }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
  .premium-benefits-{{ section.id }} {
    --premium-benefits-bg: {{ section.settings.background_color }};
    --premium-benefits-text: {{ section.settings.text_color }};
    --premium-benefits-muted: {{ section.settings.muted_color }};
    --premium-benefits-accent: {{ section.settings.accent_color }};
    --premium-editorial-heading-font: 'Spectral', Georgia, 'Times New Roman', serif;
    --premium-editorial-body-font: var(--font-body--family);
    --premium-benefits-line: rgb(29 28 26 / 0.12);
    background: var(--premium-benefits-bg);
    color: var(--premium-benefits-text);
    font-family: var(--premium-editorial-body-font);
  }

  .premium-benefits-{{ section.id }} .premium-benefits__inner {
    width: min(calc(100% - 32px), var(--normal-page-width, 120rem));
    margin-inline: auto;
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }

  .premium-benefits-{{ section.id }} .premium-benefits__header {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(280px, 0.58fr);
    gap: 32px;
    align-items: end;
    margin-bottom: 34px;
  }

  .premium-benefits-{{ section.id }} .premium-benefits__heading {
    color: inherit;
    font-family: var(--premium-editorial-heading-font);
    font-style: normal;
    font-weight: 300;
    font-size: 4rem;
    line-height: 1.04;
    letter-spacing: 0;
    margin: 0;
    max-width: 13ch;
  }

  .premium-benefits-{{ section.id }} .premium-benefits__text {
    color: var(--premium-benefits-muted);
    font-family: var(--premium-editorial-body-font);
    font-size: 1.42rem;
    line-height: 1.68;
    letter-spacing: 0;
  }

  .premium-benefits-{{ section.id }} .premium-benefits__text p {
    margin: 0;
  }

  .premium-benefits-{{ section.id }} .premium-benefits__items {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--premium-benefits-line);
    border-left: 1px solid var(--premium-benefits-line);
  }

  .premium-benefits-{{ section.id }} .premium-benefits__item {
    min-width: 0;
    padding: 26px 24px 28px;
    border-right: 1px solid var(--premium-benefits-line);
    border-bottom: 1px solid var(--premium-benefits-line);
  }

  .premium-benefits-{{ section.id }} .premium-benefits__marker {
    color: var(--premium-benefits-accent);
    display: block;
    font-family: var(--premium-editorial-body-font);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.16em;
    margin-bottom: 28px;
  }

  .premium-benefits-{{ section.id }} .premium-benefits__title {
    color: inherit;
    font-family: var(--premium-editorial-body-font);
    font-size: 1.5rem;
    line-height: 1.3;
    letter-spacing: 0;
    font-weight: 600;
    margin: 0;
  }

  .premium-benefits-{{ section.id }} .premium-benefits__description {
    color: var(--premium-benefits-muted);
    font-family: var(--premium-editorial-body-font);
    font-size: 1.3rem;
    line-height: 1.56;
    letter-spacing: 0;
    margin: 10px 0 0;
  }

  @media screen and (max-width: 989px) {
    .premium-benefits-{{ section.id }} .premium-benefits__header {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .premium-benefits-{{ section.id }} .premium-benefits__heading {
      font-size: 3.2rem;
    }

    .premium-benefits-{{ section.id }} .premium-benefits__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 750px) {
    .premium-benefits-{{ section.id }} .premium-benefits__inner {
      width: min(calc(100% - 80px), var(--normal-page-width, 120rem));
    }
  }

  @media screen and (max-width: 749px) {
    .premium-benefits-{{ section.id }} .premium-benefits__inner {
      padding-block: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_bottom }}px;
    }

    .premium-benefits-{{ section.id }} .premium-benefits__header {
      margin-bottom: 28px;
    }

    .premium-benefits-{{ section.id }} .premium-benefits__heading {
      font-size: 2.8rem;
      max-width: 18ch;
    }

    .premium-benefits-{{ section.id }} .premium-benefits__text {
      font-size: 1.35rem;
    }

    .premium-benefits-{{ section.id }} .premium-benefits__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .premium-benefits-{{ section.id }} .premium-benefits__item {
      padding: 18px 15px 20px;
    }

    .premium-benefits-{{ section.id }} .premium-benefits__marker {
      margin-bottom: 18px;
    }

    .premium-benefits-{{ section.id }} .premium-benefits__title {
      font-size: 1.35rem;
    }

    .premium-benefits-{{ section.id }} .premium-benefits__description {
      font-size: 1.22rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Premium benefits",
  "class": "shopify-section--premium-benefits",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Considered from bead to box"
