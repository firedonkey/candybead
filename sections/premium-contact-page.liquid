{% liquid
  assign contact_image = section.settings.image
  assign contact_alt = section.settings.image_alt | default: contact_image.alt | default: section.settings.heading | strip_html
  assign form_id = section.id | prepend: 'PremiumContact-'
%}

<section class="premium-contact-page premium-contact-page-{{ section.id }}">
  <div class="premium-contact-page__inner">
    <header class="premium-contact-page__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="premium-contact-page__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="premium-contact-page__heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="premium-contact-page__text rte">{{ section.settings.text }}</div>
      {% endif %}
    </header>

    <div class="premium-contact-page__contact">
      <div class="premium-contact-page__media">
        {% if contact_image != blank %}
          {{
            contact_image
            | image_url: width: 1600
            | image_tag:
              widths: '420, 640, 860, 1100, 1400, 1600',
              sizes: '(min-width: 990px) 46vw, 100vw',
              alt: contact_alt,
              class: 'premium-contact-page__image',
              loading: 'eager',
              fetchpriority: 'high'
          }}
        {% else %}
          <img
            src="{{ 'newsletter-bracelet-lifestyle.jpg' | asset_url }}"
            alt="{{ section.settings.fallback_image_alt | escape }}"
            class="premium-contact-page__image"
            width="1003"
            height="1568"
            loading="eager"
            fetchpriority="high"
          >
        {% endif %}
      </div>

      <div class="premium-contact-page__form-panel">
        {% if section.settings.form_eyebrow != blank %}
          <p class="premium-contact-page__form-eyebrow">{{ section.settings.form_eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.form_heading != blank %}
          <h2 class="premium-contact-page__form-heading">{{ section.settings.form_heading }}</h2>
        {% endif %}

        {% if section.settings.form_text != blank %}
          <div class="premium-contact-page__form-text rte">{{ section.settings.form_text }}</div>
        {% endif %}

        {% if section.settings.required_note != blank %}
          <p class="premium-contact-page__required-note">{{ section.settings.required_note | escape }}</p>
        {% endif %}

        {%- form 'contact', id: form_id, class: 'premium-contact-page__form' -%}
          <input
            name="contact[id]"
            type="hidden"
            value="{{ form_id }}"
          >

          {% liquid
            assign form_matches = false
            if form.id == form_id or form.id == blank
              assign form_matches = true
            endif
          %}

          {% if form.errors and form_matches %}
            <div
              class="premium-contact-page__message premium-contact-page__message--error"
              id="PremiumContactError-{{ section.id }}"
              role="alert"
              tabindex="-1"
              autofocus
            >
              {{ 'icon-error.svg' | inline_asset_content }}
              <span>
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </span>
            </div>
          {% endif %}

          {% if form.posted_successfully? and form_matches %}
            <div
              class="premium-contact-page__message premium-contact-page__message--success"
              id="PremiumContactSuccess-{{ section.id }}"
              role="status"
              tabindex="-1"
              autofocus
            >
              {{ 'icon-checkmark.svg' | inline_asset_content }}
              <span>{{ section.settings.success_message | escape }}</span>
            </div>
          {% endif %}

          <div class="premium-contact-page__field-grid">
            <div class="premium-contact-page__field">
              <label class="premium-contact-page__label" for="PremiumContactName-{{ section.id }}">
                {{ section.settings.name_label | escape }}
                <span aria-hidden="true">*</span>
                <span class="visually-hidden">required</span>
              </label>
              <input
                id="PremiumContactName-{{ section.id }}"
                class="premium-contact-page__input"
                type="text"
                name="contact[name]"
                autocomplete="name"
                value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}"
                required
                aria-required="true"
              >
            </div>

            <div class="premium-contact-page__field">
              <label class="premium-contact-page__label" for="PremiumContactEmail-{{ section.id }}">
                {{ section.settings.email_label | escape }}
                <span aria-hidden="true">*</span>
                <span class="visually-hidden">required</span>
              </label>
              <input
                id="PremiumContactEmail-{{ section.id }}"
                class="premium-contact-page__input"
                type="email"
                name="contact[email]"
                autocomplete="email"
                spellcheck="false"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}"
                required
                aria-required="true"
                {% if form.errors contains 'email' and form_matches %}
                  aria-invalid="true"
                  aria-describedby="PremiumContactError-{{ section.id }}"
                {% endif %}
              >
            </div>
          </div>

          <div class="premium-contact-page__field">
            <label class="premium-contact-page__label" for="PremiumContactPhone-{{ section.id }}">
              {{ section.settings.phone_label | escape }}
              <span class="premium-contact-page__optional">{{ section.settings.optional_label | escape }}</span>
            </label>
            <input
              id="PremiumContactPhone-{{ section.id }}"
              class="premium-contact-page__input"
              type="tel"
              name="contact[phone]"
              autocomplete="tel"
              value="{% if form.phone %}{{ form.phone | escape }}{% elsif customer %}{{ customer.phone | escape }}{% endif %}"
            >
          </div>

          <div class="premium-contact-page__field">
            <label class="premium-contact-page__label" for="PremiumContactMessage-{{ section.id }}">
              {{ section.settings.message_label | escape }}
              <span aria-hidden="true">*</span>
              <span class="visually-hidden">required</span>
            </label>
            <textarea
              id="PremiumContactMessage-{{ section.id }}"
              class="premium-contact-page__input premium-contact-page__textarea"
              name="contact[body]"
              rows="7"
              required
              aria-required="true"
            >{{ form.body | escape }}</textarea>
          </div>

          <button class="premium-contact-page__button" type="submit">
            {{ section.settings.submit_label | escape }}
          </button>
        {%- endform -%}
      </div>
    </div>

    {% if section.settings.show_help and section.blocks.size > 0 %}
      <div class="premium-contact-page__help">
        <div class="premium-contact-page__help-header">
          {% if section.settings.help_eyebrow != blank %}
            <p class="premium-contact-page__eyebrow">{{ section.settings.help_eyebrow | escape }}</p>
          {% endif %}

          {% if section.settings.help_heading != blank %}
            <h2 class="premium-contact-page__help-heading">{{ section.settings.help_heading }}</h2>
          {% endif %}

          {% if section.settings.help_text != blank %}
            <div class="premium-contact-page__help-text rte">{{ section.settings.help_text }}</div>
          {% endif %}
        </div>

        <div class="premium-contact-page__help-items">
          {% for block in section.blocks %}
            <article class="premium-contact-page__help-item" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h3 class="premium-contact-page__help-item-heading">{{ block.settings.heading | escape }}</h3>
              {% endif %}

              {% if block.settings.text != blank %}
                <div class="premium-contact-page__help-item-text rte">{{ block.settings.text }}</div>
              {% endif %}
            </article>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</section>

{% style %}
  @font-face {
    font-family: 'Spectral';
    font-style: normal;
    font-weight: 300;
    font-display: swap;
    src: url({{ 'spectral-light.ttf' | asset_url }}) format('truetype');
  }

  @font-face {
    font-family: 'Spectral';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url({{ 'spectral-regular.ttf' | asset_url }}) format('truetype');
  }

  .premium-contact-page-{{ section.id }} {
    --premium-contact-bg: {{ section.settings.background_color }};
    --premium-contact-panel: {{ section.settings.panel_color }};
    --premium-contact-text: {{ section.settings.text_color }};
    --premium-contact-muted: {{ section.settings.muted_color }};
    --premium-contact-accent: {{ section.settings.accent_color }};
    --premium-contact-ink: #1d1c1a;
    --premium-contact-paper: #faf8f5;
    --premium-editorial-heading-font: 'Spectral', Georgia, 'Times New Roman', serif;
    --premium-editorial-body-font: var(--font-body--family);
    background: var(--premium-contact-bg);
    color: var(--premium-contact-text);
    font-family: var(--premium-editorial-body-font);
    overflow: hidden;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__inner {
    width: min(calc(100% - 32px), var(--normal-page-width, 120rem));
    margin-inline: auto;
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__intro {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(300px, 0.42fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: end;
    margin-bottom: clamp(42px, 6vw, 76px);
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__eyebrow,
  .premium-contact-page-{{ section.id }} .premium-contact-page__form-eyebrow {
    color: var(--premium-contact-accent);
    font-family: var(--premium-editorial-body-font);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1.4;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__heading,
  .premium-contact-page-{{ section.id }} .premium-contact-page__form-heading,
  .premium-contact-page-{{ section.id }} .premium-contact-page__help-heading {
    color: inherit;
    font-family: var(--premium-editorial-heading-font);
    font-style: normal;
    font-weight: 300;
    letter-spacing: 0;
    margin: 0;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__heading {
    font-size: clamp(4.2rem, 5vw, 6.4rem);
    line-height: 0.98;
    max-width: 12ch;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__text,
  .premium-contact-page-{{ section.id }} .premium-contact-page__form-text,
  .premium-contact-page-{{ section.id }} .premium-contact-page__help-text,
  .premium-contact-page-{{ section.id }} .premium-contact-page__help-item-text {
    color: var(--premium-contact-muted);
    font-family: var(--premium-editorial-body-font);
    letter-spacing: 0;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__text {
    font-size: 1.58rem;
    line-height: 1.72;
    max-width: 520px;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__text p,
  .premium-contact-page-{{ section.id }} .premium-contact-page__form-text p,
  .premium-contact-page-{{ section.id }} .premium-contact-page__help-text p,
  .premium-contact-page-{{ section.id }} .premium-contact-page__help-item-text p {
    margin: 0;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__contact {
    background: var(--premium-contact-panel);
    border-block: 1px solid rgb(29 28 26 / 0.1);
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(380px, 1fr);
    min-width: 0;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__media {
    aspect-ratio: 5 / 6;
    background: #c9cec3;
    min-height: 100%;
    overflow: hidden;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__image {
    display: block;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
    width: 100%;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__form-panel {
    align-self: center;
    padding: clamp(34px, 5.5vw, 72px);
    min-width: 0;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__form-heading {
    font-size: clamp(3rem, 3.2vw, 4.6rem);
    line-height: 1.04;
    max-width: 12ch;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__form-text {
    font-size: 1.42rem;
    line-height: 1.7;
    margin-top: 18px;
    max-width: 480px;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__required-note {
    color: var(--premium-contact-muted);
    font-family: var(--premium-editorial-body-font);
    font-size: 1.2rem;
    letter-spacing: 0;
    line-height: 1.4;
    margin: 28px 0 0;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__form {
    display: grid;
    gap: 20px;
    margin-top: 18px;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__field-grid {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__field {
    display: grid;
    gap: 8px;
    min-width: 0;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__label {
    color: var(--premium-contact-text);
    font-family: var(--premium-editorial-body-font);
    font-size: 1.22rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.3;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__optional {
    color: var(--premium-contact-muted);
    font-weight: 400;
    letter-spacing: 0;
    margin-left: 4px;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__input {
    appearance: none;
    background: rgb(250 248 245 / 0.78);
    border: 1px solid rgb(29 28 26 / 0.18);
    border-radius: 2px;
    box-sizing: border-box;
    color: var(--premium-contact-ink);
    font-family: var(--premium-editorial-body-font);
    font-size: 1.45rem;
    letter-spacing: 0;
    line-height: 1.45;
    min-height: 50px;
    padding: 13px 15px;
    width: 100%;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__textarea {
    min-height: 164px;
    resize: vertical;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__input:focus-visible {
    border-color: var(--premium-contact-accent);
    box-shadow: 0 0 0 2px rgb(215 174 163 / 0.28);
    outline: 0;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__button {
    align-items: center;
    background: var(--premium-contact-ink);
    border: 1px solid var(--premium-contact-ink);
    border-radius: 2px;
    color: var(--premium-contact-paper);
    cursor: pointer;
    display: inline-flex;
    font-family: var(--premium-editorial-body-font);
    font-size: 1.28rem;
    font-weight: 600;
    justify-content: center;
    justify-self: start;
    letter-spacing: 0.04em;
    line-height: 1.2;
    min-height: 50px;
    padding: 14px 26px;
    transition: background-color 220ms ease, border-color 220ms ease, color 220ms ease, transform 220ms ease;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__button:hover {
    background: var(--premium-contact-accent);
    border-color: var(--premium-contact-accent);
    color: var(--premium-contact-ink);
    transform: translateY(-1px);
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__button:focus-visible {
    outline: 2px solid var(--premium-contact-accent);
    outline-offset: 4px;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__message {
    align-items: center;
    display: flex;
    gap: 10px;
    font-family: var(--premium-editorial-body-font);
    font-size: 1.34rem;
    letter-spacing: 0;
    line-height: 1.45;
    padding: 12px 14px;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__message svg {
    flex: 0 0 18px;
    height: 18px;
    width: 18px;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__message--success {
    background: rgb(201 206 195 / 0.34);
    color: var(--premium-contact-ink);
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__message--error {
    background: rgb(159 58 40 / 0.08);
    color: #8a2f22;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__help {
    border-top: 1px solid rgb(29 28 26 / 0.1);
    display: grid;
    gap: clamp(30px, 5vw, 60px);
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr);
    margin-top: clamp(56px, 7vw, 92px);
    padding-top: clamp(38px, 5vw, 60px);
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__help-heading {
    font-size: clamp(2.8rem, 3vw, 4rem);
    line-height: 1.04;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__help-text {
    font-size: 1.38rem;
    line-height: 1.68;
    margin-top: 18px;
    max-width: 420px;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__help-items {
    display: grid;
    gap: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__help-item {
    border-top: 1px solid rgb(29 28 26 / 0.1);
    padding: 22px 0;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__help-item:nth-child(1),
  .premium-contact-page-{{ section.id }} .premium-contact-page__help-item:nth-child(2) {
    border-top: 0;
    padding-top: 0;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__help-item:nth-child(odd) {
    padding-right: 28px;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__help-item:nth-child(even) {
    border-left: 1px solid rgb(29 28 26 / 0.1);
    padding-left: 28px;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__help-item-heading {
    color: var(--premium-contact-text);
    font-family: var(--premium-editorial-body-font);
    font-size: 1.42rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.35;
    margin: 0 0 8px;
  }

  .premium-contact-page-{{ section.id }} .premium-contact-page__help-item-text {
    font-size: 1.32rem;
    line-height: 1.62;
  }

  @media screen and (min-width: 750px) {
    .premium-contact-page-{{ section.id }} .premium-contact-page__inner {
      width: min(calc(100% - 80px), var(--normal-page-width, 120rem));
    }
  }

  @media screen and (max-width: 989px) {
    .premium-contact-page-{{ section.id }} .premium-contact-page__intro,
    .premium-contact-page-{{ section.id }} .premium-contact-page__contact,
    .premium-contact-page-{{ section.id }} .premium-contact-page__help {
      grid-template-columns: 1fr;
    }

    .premium-contact-page-{{ section.id }} .premium-contact-page__intro {
      align-items: start;
    }

    .premium-contact-page-{{ section.id }} .premium-contact-page__media {
      aspect-ratio: 4 / 3;
      min-height: 0;
    }

    .premium-contact-page-{{ section.id }} .premium-contact-page__form-panel {
      padding: clamp(30px, 6vw, 48px);
    }

    .premium-contact-page-{{ section.id }} .premium-contact-page__help-items {
      grid-template-columns: 1fr;
    }

    .premium-contact-page-{{ section.id }} .premium-contact-page__help-item,
    .premium-contact-page-{{ section.id }} .premium-contact-page__help-item:nth-child(1),
    .premium-contact-page-{{ section.id }} .premium-contact-page__help-item:nth-child(2) {
      border-left: 0;
      border-top: 1px solid rgb(29 28 26 / 0.1);
      padding: 20px 0;
    }

    .premium-contact-page-{{ section.id }} .premium-contact-page__help-item:first-child {
      border-top: 0;
      padding-top: 0;
    }
  }

  @media screen and (max-width: 749px) {
    .premium-contact-page-{{ section.id }} .premium-contact-page__inner {
      padding-block: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_bottom }}px;
    }

    .premium-contact-page-{{ section.id }} .premium-contact-page__heading {
      font-size: 3.6rem;
      line-height: 1.02;
      max-width: 11ch;
    }

    .premium-contact-page-{{ section.id }} .premium-contact-page__text,
    .premium-contact-page-{{ section.id }} .premium-contact-page__form-text {
      font-size: 1.34rem;
      line-height: 1.66;
    }

    .premium-contact-page-{{ section.id }} .premium-contact-page__media {
      aspect-ratio: 1 / 1.04;
    }

    .premium-contact-page-{{ section.id }} .premium-contact-page__form-heading {
      font-size: 2.9rem;
      max-width: 13ch;
    }

    .premium-contact-page-{{ section.id }} .premium-contact-page__field-grid {
      grid-template-columns: 1fr;
    }

    .premium-contact-page-{{ section.id }} .premium-contact-page__input {
      font-size: 1.6rem;
      min-height: 52px;
    }

    .premium-contact-page-{{ section.id }} .premium-contact-page__button {
      justify-self: stretch;
      min-height: 52px;
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .premium-contact-page-{{ section.id }} .premium-contact-page__button {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Premium contact page",
  "class": "shopify-section--premium-contact-page",
  "settings": [
    {
      "type": "header",
      "content": "Intro"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "GET IN TOUCH"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "We'd love to hear from you."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Questions about a piece, an order, or finding the right bracelet? Send us a note and we'll be happy to help.</p>"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
