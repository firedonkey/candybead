{% liquid
  assign newsletter_image = section.settings.image
  assign newsletter_alt = section.settings.image_alt | default: newsletter_image.alt | default: section.settings.fallback_image_alt | default: section.settings.heading | strip_html
%}

<section class="premium-newsletter premium-newsletter-{{ section.id }}">
  <div class="premium-newsletter__inner">
    <div class="premium-newsletter__content">
      {% if section.settings.eyebrow != blank %}
        <p class="premium-newsletter__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="premium-newsletter__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="premium-newsletter__text rte">{{ section.settings.text }}</div>
      {% endif %}

      {% form 'customer', class: 'premium-newsletter__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="premium-newsletter__field">
          <label class="visually-hidden" for="PremiumNewsletterEmail-{{ section.id }}">
            Email address
          </label>
          <input
            id="PremiumNewsletterEmail-{{ section.id }}"
            class="premium-newsletter__input"
            type="email"
            name="contact[email]"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            placeholder="{{ section.settings.placeholder | escape }}"
            required
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="PremiumNewsletterMessage-{{ section.id }}"
            {% endif %}
          >
          <button class="premium-newsletter__button" type="submit">
            {{ section.settings.button_label | escape }}
          </button>
        </div>

        {% if form.posted_successfully? %}
          <p class="premium-newsletter__message" id="PremiumNewsletterMessage-{{ section.id }}">
            {{ section.settings.success_message | escape }}
          </p>
        {% elsif form.errors %}
          <p class="premium-newsletter__message premium-newsletter__message--error" id="PremiumNewsletterMessage-{{ section.id }}">
            {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </p>
        {% endif %}
      {% endform %}
    </div>

    <div class="premium-newsletter__media">
      {% if newsletter_image != blank %}
        {{
          newsletter_image
          | image_url: width: 1400
          | image_tag:
            widths: '420, 640, 900, 1200, 1400',
            sizes: '(min-width: 990px) 44vw, 100vw',
            alt: newsletter_alt,
            class: 'premium-newsletter__image',
            loading: 'lazy'
        }}
      {% else %}
        <img
          src="{{ 'newsletter-bracelet-lifestyle.jpg' | asset_url }}"
          alt="{{ section.settings.fallback_image_alt | default: section.settings.heading | strip_html | escape }}"
          class="premium-newsletter__image"
          width="1003"
          height="1568"
          loading="lazy"
        >
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  .premium-newsletter-{{ section.id }} {
    --premium-newsletter-bg: {{ section.settings.background_color }};
    --premium-newsletter-text: {{ section.settings.text_color }};
    --premium-newsletter-muted: {{ section.settings.muted_color }};
    --premium-newsletter-accent: {{ section.settings.accent_color }};
    --premium-editorial-heading-font: 'Spectral', Georgia, 'Times New Roman', serif;
    --premium-editorial-body-font: var(--font-body--family);
    --premium-newsletter-ink: #1d1c1a;
    --premium-newsletter-paper: #faf8f5;
    background: var(--premium-newsletter-bg);
    color: var(--premium-newsletter-text);
    font-family: var(--premium-editorial-body-font);
  }

  .premium-newsletter-{{ section.id }} .premium-newsletter__inner {
    width: min(calc(100% - 32px), var(--normal-page-width, 120rem));
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 0.68fr);
    gap: clamp(44px, 6vw, 76px);
    align-items: center;
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }

  .premium-newsletter-{{ section.id }} .premium-newsletter__eyebrow {
    color: var(--premium-newsletter-accent);
    font-family: var(--premium-editorial-body-font);
    font-size: 1rem;
    line-height: 1.4;
    letter-spacing: 0.16em;
    margin: 0 0 12px;
    text-transform: uppercase;
    font-weight: 600;
  }

  .premium-newsletter-{{ section.id }} .premium-newsletter__heading {
    color: inherit;
    font-family: var(--premium-editorial-heading-font);
    font-style: normal;
    font-weight: 300;
    font-size: 4.8rem;
    line-height: 1.02;
    letter-spacing: 0;
    margin: 0;
    max-width: 12.5ch;
  }

  .premium-newsletter-{{ section.id }} .premium-newsletter__text {
    color: var(--premium-newsletter-muted);
    font-family: var(--premium-editorial-body-font);
    font-size: 1.52rem;
    line-height: 1.72;
    letter-spacing: 0;
    margin-top: 24px;
    max-width: 560px;
  }

  .premium-newsletter-{{ section.id }} .premium-newsletter__text p {
    margin: 0;
  }

  .premium-newsletter-{{ section.id }} .premium-newsletter__form {
    margin-top: 34px;
    max-width: 620px;
  }

  .premium-newsletter-{{ section.id }} .premium-newsletter__field {
    display: flex;
    background: rgb(250 248 245 / 0.82);
    border: 1px solid rgb(29 28 26 / 0.18);
    border-radius: 2px;
    padding: 4px;
  }

  .premium-newsletter-{{ section.id }} .premium-newsletter__input {
    background: transparent;
    border: 0;
    color: var(--premium-newsletter-ink);
    flex: 1;
    min-width: 0;
    padding: 0 16px;
    min-height: 50px;
    font-family: var(--premium-editorial-body-font);
    font-size: 1.45rem;
    letter-spacing: 0;
  }

  .premium-newsletter-{{ section.id }} .premium-newsletter__input::placeholder {
    color: rgb(29 28 26 / 0.48);
  }

  .premium-newsletter-{{ section.id }} .premium-newsletter__input:focus-visible {
    outline: 0;
  }

  .premium-newsletter-{{ section.id }} .premium-newsletter__field:focus-within {
    border-color: var(--premium-newsletter-accent);
    box-shadow: 0 0 0 2px rgb(215 174 163 / 0.28);
  }

  .premium-newsletter-{{ section.id }} .premium-newsletter__button {
    background: var(--premium-newsletter-ink);
    border: 1px solid var(--premium-newsletter-ink);
    border-radius: 2px;
    color: var(--premium-newsletter-paper);
    cursor: pointer;
    font-family: var(--premium-editorial-body-font);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    min-height: 50px;
    padding: 0 24px;
    white-space: nowrap;
    transition: background-color 220ms ease, border-color 220ms ease, color 220ms ease;
  }

  .premium-newsletter-{{ section.id }} .premium-newsletter__button:hover {
    background: var(--premium-newsletter-accent);
    border-color: var(--premium-newsletter-accent);
    color: var(--premium-newsletter-ink);
  }

  .premium-newsletter-{{ section.id }} .premium-newsletter__button:focus-visible {
    outline: 2px solid var(--premium-newsletter-accent);
    outline-offset: 3px;
  }

  .premium-newsletter-{{ section.id }} .premium-newsletter__message {
    color: var(--premium-newsletter-accent);
    font-family: var(--premium-editorial-body-font);
    font-size: 1.3rem;
    line-height: 1.45;
    letter-spacing: 0;
    margin: 16px 0 0;
  }

  .premium-newsletter-{{ section.id }} .premium-newsletter__message--error {
    color: #9f3a28;
  }

  .premium-newsletter-{{ section.id }} .premium-newsletter__media {
    aspect-ratio: 4 / 5;
    background: #c9cec3;
    border-radius: 2px;
    overflow: hidden;
  }

  .premium-newsletter-{{ section.id }} .premium-newsletter__image,
  .premium-newsletter-{{ section.id }} .premium-newsletter__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  @media screen and (max-width: 989px) {
    .premium-newsletter-{{ section.id }} .premium-newsletter__inner {
      grid-template-columns: 1fr;
    }

    .premium-newsletter-{{ section.id }} .premium-newsletter__heading {
      font-size: 3.6rem;
      max-width: 14ch;
    }
  }

  @media screen and (min-width: 750px) {
    .premium-newsletter-{{ section.id }} .premium-newsletter__inner {
      width: min(calc(100% - 80px), var(--normal-page-width, 120rem));
    }
  }

  @media screen and (max-width: 749px) {
    .premium-newsletter-{{ section.id }} .premium-newsletter__inner {
      padding-block: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_bottom }}px;
    }

    .premium-newsletter-{{ section.id }} .premium-newsletter__heading {
      font-size: 2.8rem;
    }

    .premium-newsletter-{{ section.id }} .premium-newsletter__field {
      display: grid;
      gap: 14px;
      background: transparent;
      border: 0;
      padding: 0;
    }

    .premium-newsletter-{{ section.id }} .premium-newsletter__input {
      background: rgb(250 248 245 / 0.82);
      border: 1px solid rgb(29 28 26 / 0.18);
      border-radius: 2px;
      min-height: 50px;
    }

    .premium-newsletter-{{ section.id }} .premium-newsletter__button {
      min-height: 46px;
      padding: 13px 18px;
      justify-self: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .premium-newsletter-{{ section.id }} .premium-newsletter__button {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Premium newsletter",
  "class": "shopify-section--premium-newsletter",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "fallback_image_alt",
      "label": "Fallback image alt text",
      "default": "Wrist wearing handmade bead bracelets in warm natural light"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The edit"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "A little beauty in your inbox."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>New pieces, styling inspiration, and occasional notes from Candy Bead.</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Sign up"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you for signing up."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f7f4ef"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1d1c1a"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#77716b"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#d7aea3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 40,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 104
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 40,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 104
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 28,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 68
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 28,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 68
    }
  ],
  "presets": [
    {
      "name": "Premium newsletter"
    }
  ]
}
{% endschema %}
